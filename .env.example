# =====================================================================
# KREAZYAI ENVIRONMENT CONFIGURATION
# =====================================================================

PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://kreazyai.com,https://www.kreazyai.com,https://kreazyai.onrender.com

# Frontend Hosting Configuration (Vite Build / CloudFront / S3 / Netlify / Vercel)
# Configurable production API base URL pointing to Render backend
VITE_API_URL=https://kreazyai.onrender.com

# Database Configuration
DATABASE_URL=./data/kreazy.db

# Authentication & Security
JWT_SECRET=kreazy_ai_production_jwt_secret_key_32_bytes_min_2026!
JWT_EXPIRES_IN=7d

# Initial Platform Super Admin (Seeded with bcrypt hash on first launch)
SUPER_ADMIN_EMAIL=admin@kreazyai.com
SUPER_ADMIN_PASSWORD=KreazyAI_Admin_2026!

# AI Provider Configurations
AI_PROVIDER=ollama # ollama | gemini | openai | heuristic
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL_NAME=gemini-2.0-flash

# Ollama Local Configuration (Used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_MS=120000

# Meta WhatsApp Business Platform / Cloud API Configuration
META_APP_ID=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=kreazy_meta_webhook_verification_token_2026
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# Backward Compatibility Meta Aliases
META_VERIFY_TOKEN=kreazy_meta_webhook_verification_token_2026
META_WHATSAPP_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=

# Optional Render Messenger Test Page Integration
# Explicitly maps a single verified Facebook Page to one tenant without exposing secrets to frontend or SQLite
MESSENGER_PAGE_ID=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_TENANT_ID=

# Smart Sales Recovery Agent
RECOVERY_DEFAULT_INACTIVITY_MINUTES=30
RECOVERY_DEFAULT_MIN_INTENT_SCORE=0.70
RECOVERY_DEFAULT_DRY_RUN=true
RECOVERY_DEFAULT_QUIET_HOURS_ENABLED=true
RECOVERY_DEFAULT_QUIET_HOURS_START=22:00
RECOVERY_DEFAULT_QUIET_HOURS_END=08:00
RECOVERY_WORKER_POLL_INTERVAL_MS=30000
